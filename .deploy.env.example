# 远程服务器地址或 ~/.ssh/config 中定义的 Host 别名（必填）
DEPLOY_HOST=your-nas-or-server

# SSH 登录用户名（若 ~/.ssh/config 已配置 User 可留空）
DEPLOY_USER=

# SSH 端口（默认 22）
DEPLOY_PORT=22

# 可选 SSH 私钥路径（留空则使用默认 SSH Agent / ~/.ssh/config）
DEPLOY_SSH_KEY=

# 远程服务器上的项目部署目录（必填，如 /opt/bdownloader 或 /volume1/docker/bdownloader）
DEPLOY_DIR=/opt/bdownloader

# 可选远程 Docker Compose 命令（留空时自动探测 "docker compose" 或 "docker-compose"）
DEPLOY_COMPOSE_CMD=

# 是否将本地 .env 同步覆盖到服务器（默认 false，保护线上密钥）
DEPLOY_SYNC_ENV=false

# 当 DEPLOY_SYNC_ENV=true 时使用的本地环境变量文件（默认 .env）
DEPLOY_ENV_FILE=.env

# 同步代码时是否保留服务器现有 shortcut.json（默认 false，使用本地版本）
DEPLOY_KEEP_REMOTE_SHORTCUT=false

# 可选外部健康检查基地址（如 https://your-domain.example；留空则通过 SSH 在服务器本机探测 127.0.0.1:8787）
DEPLOY_HEALTH_URL=

# 容器启动后等待健康检查就绪的最大秒数（默认 45）
DEPLOY_HEALTH_TIMEOUT=45
