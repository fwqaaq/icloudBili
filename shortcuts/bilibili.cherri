#define name bilibili 视频下载
#define color pink
#define glyph downloadArrow
#define inputs url, text, richtext, webpage, article
#define from sharesheet

#include 'actions/web'
#include 'actions/sharing'
#include 'actions/photos'
#include 'actions/documents'
#include 'actions/device'
#include 'actions/math'
#include 'actions/text'

const currentVersion = "3.0.0"
const currentBuild = 5
const baseUrl = "http://nas.wzszz.top:8787"

// 0. 读取或生成当前设备的持久化唯一 ID（用于 Stripe 设备数控制）
const devIdFile = getFile("bdownloader-device-id.txt", nil, false)
@deviceId = "{devIdFile}"
const devIdLen = count(@deviceId, "Characters")
if devIdLen == 0 {
    const r1 = randomNumber(100000, 999999)
    const r2 = randomNumber(100000, 999999)
    @deviceId = "ios-{r1}-{r2}"
    saveFile("bdownloader-device-id.txt", @deviceId, true)
}
const devNameRaw = getDeviceDetail("Device Name")
@deviceName = "{devNameRaw}"

// 1. 检查服务端版本（强制更新）并动态获取接口基地址
@apiBase = baseUrl
const updateRes = downloadURL("{baseUrl}/api/shortcut")
@updateText = "{updateRes}"
if @updateText contains "version" {
    const updateDict = getDictionary(updateRes)
    const remoteVersionVal = getValue(updateDict, "version")
    const remoteBuildVal = getValue(updateDict, "build")
    const changelogVal = getValue(updateDict, "changelog")
    const updatePageVal = getValue(updateDict, "updatePageUrl")
    const apiBaseVal = getValue(updateDict, "apiBaseUrl")

    @remoteApiBase = "{apiBaseVal}"
    if @remoteApiBase beginsWith "http" {
        @apiBase = @remoteApiBase
    }

    @remoteVersion = "{remoteVersionVal}"
    const remoteBuild = getNumbers(remoteBuildVal)
    @changelog = "{changelogVal}"
    const changelogLen = count(@changelog, "Characters")
    if changelogLen == 0 {
        @changelog = "检测到新版本，点击确认前往更新页面。"
    }
    @updatePage = "{updatePageVal}"
    const updatePageLen = count(@updatePage, "Characters")
    if updatePageLen == 0 {
        @updatePage = "{@apiBase}/"
    }

    if remoteBuild > currentBuild {
        confirm(@changelog, "发现新版本 v{@remoteVersion}（需更新）")
        openURL(@updatePage)
        stop()
    } else {
        const remoteVerLen = count(@remoteVersion, "Characters")
        if remoteVerLen > 0 {
            if @remoteVersion != currentVersion {
                confirm(@changelog, "发现新版本 v{@remoteVersion}（需更新）")
                openURL(@updatePage)
                stop()
            }
        }
    }
}

// 2. 支持从 Stripe 成功页通过 shortcuts:// 回调自动激活授权码（支持 LICENSE: 或 ACTIVATE: 前缀）
if ShortcutInput {
    @incomingText = "{ShortcutInput}"
    @activationKey: text
    @isActivation = 0
    if @incomingText beginsWith "LICENSE:" {
        const stripped1 = replaceText("LICENSE:", "", @incomingText)
        @activationKey = "{stripped1}"
        @isActivation = 1
    } else {
        if @incomingText beginsWith "ACTIVATE:" {
            const stripped2 = replaceText("ACTIVATE:", "", @incomingText)
            @activationKey = "{stripped2}"
            @isActivation = 1
        }
    }

    if @isActivation == 1 {
        const actLen = count(@activationKey, "Characters")
        if actLen > 0 {
            const actRes = jsonRequest("{@apiBase}/api/license/activate", "POST", {
                "licenseKey": "{@activationKey}",
                "instanceId": "{@deviceId}",
                "instanceName": "{@deviceName}"
            })
            @actText = "{actRes}"
            if @actText contains "\"ok\":true" || @actText contains "\"valid\":true" {
                saveFile("bdownloader-license.txt", @activationKey, true)
                showNotification("会员授权码已在本设备激活并保存", "bilibili 视频下载")
            } else {
                const actDict = getDictionary(actRes)
                const actErrVal = getValue(actDict, "error")
                @actErr = "{actErrVal}"
                const actErrLen = count(@actErr, "Characters")
                if actErrLen == 0 {
                    @actErr = "激活失败，请检查授权码或网络连接"
                }
                alert(@actErr, "授权激活失败")
            }
            stop()
        }
    }
}

// 3. 获取视频链接（共享表单 -> 剪贴板 -> 手动输入）
@rawInput: text
@found = 0
if ShortcutInput {
    const shareUrls = getURLs(ShortcutInput)
    for su in shareUrls {
        if @found == 0 {
            @suText = "{su}"
            if @suText contains "b23.tv" || @suText contains "bilibili" || @suText contains "bili2233" {
                @rawInput = @suText
                @found = 1
            }
        }
    }
    if @found == 0 {
        @shareText = "{ShortcutInput}"
        if @shareText contains "b23.tv" || @shareText contains "bilibili.com" || @shareText contains "bili2233.cn" || @shareText contains "BV" || @shareText contains "av" {
            @rawInput = @shareText
            @found = 1
        }
    }
}

if @found == 0 {
    const clip = getClipboard()
    @clipText = "{clip}"
    const clipUrls = getURLs(@clipText)
    for cu in clipUrls {
        if @found == 0 {
            @cuText = "{cu}"
            if @cuText contains "b23.tv" || @cuText contains "bilibili" || @cuText contains "bili2233" {
                @rawInput = @cuText
                @found = 1
            }
        }
    }
    if @found == 0 {
        if @clipText contains "bilibili" || @clipText contains "b23.tv" || @clipText contains "bili2233" || @clipText contains "BV" || @clipText contains "av" {
            @rawInput = @clipText
            @found = 1
        }
    }
}

if @found == 0 {
    const manual = prompt("请输入 B 站视频链接、分享文案或 BV 号")
    @rawInput = "{manual}"
    const manualLen = count(@rawInput, "Characters")
    if manualLen > 0 {
        @found = 1
    }
}

if @found == 0 {
    alert("未提供 B 站视频链接或 BV 号", "无法下载")
    stop()
}

// 4. 选择清晰度（区分免费档与 Stripe 会员 4K/高帧率档）
@selectedQn = "80"
menu "选择视频清晰度" {
    item "自动最高 · 免费（1080P / 720P）":
        @selectedQn = "80"
    item "720P 高清 · 免费":
        @selectedQn = "64"
    item "480P 清晰 · 省流量":
        @selectedQn = "32"
    item "4K 超清 · 会员":
        @selectedQn = "120"
    item "1080P60 高帧率 · 会员":
        @selectedQn = "116"
    item "1080P+ 高码率 · 会员":
        @selectedQn = "112"
}

// 5. 读取本地持久化 License Key 并通过 POST JSON 解析（无需手工转义 URL）
const savedLicFile = getFile("bdownloader-license.txt", nil, false)
@licenseKey = "{savedLicFile}"

const apiRes = jsonRequest("{@apiBase}/api/download", "POST", {
    "bilibili": "{@rawInput}",
    "qn": "{@selectedQn}",
    "licenseKey": "{@licenseKey}",
    "instanceId": "{@deviceId}"
})
@apiText = "{apiRes}"
@proxyUrl: text
@errMsg: text
@checkoutUrl: text
@videoTitle: text
@fileName: text
@qualityLabel: text
@currentPage = "1"
@totalPages = "1"
@explicitFlag: text

if @apiText contains "proxyUrl" || @apiText contains "error" {
    const apiDict = getDictionary(apiRes)
    const proxyVal = getValue(apiDict, "proxyUrl")
    const errVal = getValue(apiDict, "error")
    const checkoutVal = getValue(apiDict, "checkoutUrl")
    const titleVal = getValue(apiDict, "title")
    const fileNameVal = getValue(apiDict, "fileName")
    const qualityLabelVal = getValue(apiDict, "qualityLabel")
    const pageVal = getValue(apiDict, "page")
    const totalPagesVal = getValue(apiDict, "totalPages")
    const explicitVal = getValue(apiDict, "hasExplicitPage")

    @proxyUrl = "{proxyVal}"
    @errMsg = "{errVal}"
    @checkoutUrl = "{checkoutVal}"
    @videoTitle = "{titleVal}"
    @fileName = "{fileNameVal}"
    @qualityLabel = "{qualityLabelVal}"
    @currentPage = "{pageVal}"
    @totalPages = "{totalPagesVal}"
    @explicitFlag = "{explicitVal}"
}

// 5.5 若触发 Stripe 会员付费拦截（返回 checkoutUrl），提供激活 / 购买 / 免费降级选项
if @checkoutUrl beginsWith "http" {
    menu "{@errMsg}" {
        item "输入 / 更换会员授权码":
            const inputKey = prompt("请输入会员授权码（如 BILI-XXXX-XXXX-XXXX-XXXX）")
            @newKey = "{inputKey}"
            const newKeyLen = count(@newKey, "Characters")
            if newKeyLen == 0 {
                stop()
            }
            const actRetryRes = jsonRequest("{@apiBase}/api/license/activate", "POST", {
                "licenseKey": "{@newKey}",
                "instanceId": "{@deviceId}",
                "instanceName": "{@deviceName}"
            })
            @actRetryText = "{actRetryRes}"
            if @actRetryText contains "\"ok\":true" || @actRetryText contains "\"valid\":true" {
                @licenseKey = @newKey
                saveFile("bdownloader-license.txt", @licenseKey, true)
                const retryRes = jsonRequest("{@apiBase}/api/download", "POST", {
                    "bilibili": "{@rawInput}",
                    "qn": "{@selectedQn}",
                    "licenseKey": "{@licenseKey}",
                    "instanceId": "{@deviceId}"
                })
                @retryText = "{retryRes}"
                if @retryText contains "proxyUrl" || @retryText contains "error" {
                    const retryDict = getDictionary(retryRes)
                    const rProxyVal = getValue(retryDict, "proxyUrl")
                    const rErrVal = getValue(retryDict, "error")
                    const rTitleVal = getValue(retryDict, "title")
                    const rFileNameVal = getValue(retryDict, "fileName")
                    const rQualVal = getValue(retryDict, "qualityLabel")
                    const rPageVal = getValue(retryDict, "page")
                    const rTotalVal = getValue(retryDict, "totalPages")
                    const rExpVal = getValue(retryDict, "hasExplicitPage")

                    @proxyUrl = "{rProxyVal}"
                    @errMsg = "{rErrVal}"
                    @videoTitle = "{rTitleVal}"
                    @fileName = "{rFileNameVal}"
                    @qualityLabel = "{rQualVal}"
                    @currentPage = "{rPageVal}"
                    @totalPages = "{rTotalVal}"
                    @explicitFlag = "{rExpVal}"
                }
            } else {
                const actRetryDict = getDictionary(actRetryRes)
                const arErrVal = getValue(actRetryDict, "error")
                @arErr = "{arErrVal}"
                const arErrLen = count(@arErr, "Characters")
                if arErrLen == 0 {
                    @arErr = "授权码激活失败，请检查输入或已达设备上限"
                }
                alert(@arErr, "授权激活失败")
                stop()
            }
        item "前往 Stripe 开通 / 续费会员":
            openURL(@checkoutUrl)
            stop()
        item "改用免费最高画质（1080P / 720P）":
            @selectedQn = "80"
            const freeRes = jsonRequest("{@apiBase}/api/download", "POST", {
                "bilibili": "{@rawInput}",
                "qn": "80"
            })
            @freeText = "{freeRes}"
            if @freeText contains "proxyUrl" || @freeText contains "error" {
                const freeDict = getDictionary(freeRes)
                const fProxyVal = getValue(freeDict, "proxyUrl")
                const fErrVal = getValue(freeDict, "error")
                const fTitleVal = getValue(freeDict, "title")
                const fFileNameVal = getValue(freeDict, "fileName")
                const fQualVal = getValue(freeDict, "qualityLabel")
                const fPageVal = getValue(freeDict, "page")
                const fTotalVal = getValue(freeDict, "totalPages")
                const fExpVal = getValue(freeDict, "hasExplicitPage")

                @proxyUrl = "{fProxyVal}"
                @errMsg = "{fErrVal}"
                @videoTitle = "{fTitleVal}"
                @fileName = "{fFileNameVal}"
                @qualityLabel = "{fQualVal}"
                @currentPage = "{fPageVal}"
                @totalPages = "{fTotalVal}"
                @explicitFlag = "{fExpVal}"
            }
    }
}

// 6. 多 P 视频且未显式指定 ?p= 时允许交互选集
if @proxyUrl beginsWith "http" {
    const totalPagesNum = getNumbers(@totalPages)
    if totalPagesNum > 1 {
        @isExplicit = "0"
        if @explicitFlag == "1" || @explicitFlag == "true" || @explicitFlag == "Yes" || @explicitFlag == "是" {
            @isExplicit = "1"
        }
        if @isExplicit == "0" {
            menu "该视频共 {@totalPages} 个分 P，当前第 1 P" {
                item "下载第 1 P":
                item "选择其他分 P":
                    const pickedPage = prompt("请输入分 P 序号（1 ~ {@totalPages}）", "Number", "1")
                    const pickedNum = getNumbers(pickedPage)
                    if pickedNum >= 1 {
                        const pageRes = jsonRequest("{@apiBase}/api/download", "POST", {
                            "bilibili": "{@rawInput}",
                            "qn": "{@selectedQn}",
                            "p": "{pickedNum}",
                            "licenseKey": "{@licenseKey}",
                            "instanceId": "{@deviceId}"
                        })
                        @pageText = "{pageRes}"
                        if @pageText contains "proxyUrl" || @pageText contains "error" {
                            const pageDict = getDictionary(pageRes)
                            const pProxyVal = getValue(pageDict, "proxyUrl")
                            const pErrVal = getValue(pageDict, "error")
                            const pTitleVal = getValue(pageDict, "title")
                            const pFileNameVal = getValue(pageDict, "fileName")
                            const pQualVal = getValue(pageDict, "qualityLabel")
                            const pNumVal = getValue(pageDict, "page")

                            @proxyUrl = "{pProxyVal}"
                            @errMsg = "{pErrVal}"
                            @videoTitle = "{pTitleVal}"
                            @fileName = "{pFileNameVal}"
                            @qualityLabel = "{pQualVal}"
                            @currentPage = "{pNumVal}"
                        }
                    }
            }
        }
    }
}

// 7. 下载视频（proxyUrl 已携带 HMAC 签名票据）、按标题重命名并选择保存位置
if @proxyUrl beginsWith "http" {
    const video = downloadURL(@proxyUrl)
    const fileNameLen = count(@fileName, "Characters")
    if fileNameLen == 0 {
        @fileName = "bilibili-video"
    }
    const namedVideo = setName(video, @fileName)

    menu "下载完成，选择保存位置" {
        item "保存到系统相册":
            savePhoto(namedVideo)
        item "保存到「文件」App":
            saveFilePrompt(namedVideo)
    }

    const titleLen = count(@videoTitle, "Characters")
    if titleLen == 0 {
        @videoTitle = "B 站视频"
    }
    const qualLen = count(@qualityLabel, "Characters")
    if qualLen > 0 {
        showNotification("《{@videoTitle}》（{@qualityLabel}）已保存", "bilibili 视频下载")
    } else {
        showNotification("《{@videoTitle}》已保存", "bilibili 视频下载")
    }
} else {
    const errLen = count(@errMsg, "Characters")
    if errLen == 0 {
        @errMsg = "未能从服务端获取有效解析结果（输入：{@rawInput}）"
    }
    alert(@errMsg, "解析失败")
}
